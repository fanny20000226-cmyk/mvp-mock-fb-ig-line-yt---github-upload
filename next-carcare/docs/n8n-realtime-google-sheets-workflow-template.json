        "jsCode": "const row = $json.row || {};\nreturn [{ json: {\n  id: $json.unique_key || row.id || '',\n  store_id: row.store_id || row.shop_id || '',\n  quotation_id: row.quotation_id || row.order_id || '',\n  payment_no: row.payment_no || row.transaction_no || '',\n  pay_amount: row.pay_amount || row.amount || row.total_amount || 0,\n  pay_time: row.pay_time || row.paid_at || row.created_at || '',\n  pay_method: row.pay_method || row.payment_method || row.method || '',\n  pay_type: row.pay_type || row.payment_type || row.type || '',\n  check_status: row.check_status || row.status || '',\n  remark: row.remark || row.note || '',\n  created_at: row.created_at || '',\n  updated_at: row.updated_at || $json.received_at\n}}];"
      },
