        "jsCode": "const row = $json.row || {};\nconst salaryId = $json.unique_key || row.id || row.salary_record_id || '';\nreturn [{ json: {\n  \"薪資年/月\": row.salary_month || row.payroll_month || '',\n  \"員工編號\": row.staff_no || row.staff_code || row.employee_no || '',\n  \"員工姓名\": row.staff_name || row.employee_name || row.name || '',\n  \"職稱\": row.position || row.title || '',\n  \"門市\": row.shop_name || row.store_name || row.shop_id || row.store_id || '',\n  \"本薪\": row.base_salary || 0,\n  \"職務津貼\": row.position_allowance || 0,\n  \"伙食津貼\": row.meal_allowance || 0,\n  \"全勤獎金\": row.attendance_bonus || row.full_attendance_bonus || 0,\n  \"加班費\": row.overtime_pay || 0,\n  \"交通津貼\": row.transport_allowance || 0,\n  \"激勵獎金\": row.incentive_bonus || 0,\n  \"外派支援津貼\": row.dispatch_allowance || row.support_allowance || 0,\n  \"應休未休\": row.unused_leave_pay || 0,\n  \"帶人金\": row.mentor_bonus || row.mentoring_bonus || 0,\n  \"績效獎金\": row.performance_bonus || 0,\n  \"業績獎金\": row.sales_bonus || 0,\n  \"勞保費(自付)\": row.labor_insurance_fee || 0,\n  \"健保費(自付)\": row.health_insurance_fee || 0,\n  \"勞退自提\": row.pension_self_pay || row.pension_self || 0,\n  \"事病假扣款\": row.sick_leave_deduction || row.leave_deduction || 0,\n  \"預支\": row.advance_payment || 0,\n  \"kip未達標扣款\": row.kip_penalty || row.kip_deduction || 0,\n  \"應給總額\": row.gross_amount || row.gross_pay || 0,\n  \"應扣總額\": row.deduction_amount || row.total_deduction || 0,\n  \"實領金額\": row.net_salary || row.net_pay || 0,\n  \"建檔時間\": row.created_at || $json.received_at || '',\n  \"建立人\": row.created_by || row.created_by_name || '',\n  \"系統薪資紀錄ID\": salaryId\n}}];"
