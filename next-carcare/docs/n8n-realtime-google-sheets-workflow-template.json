    {
      "parameters": {
        "jsCode": "const row = $json.row || {};\nreturn [{ json: {\n  id: $json.unique_key || row.id || '',\n  name: row.name || row.customer_name || row.display_name || '',\n  phone: row.phone || row.customer_phone || '',\n  license_plate: row.license_plate || row.plate_no || row.plate || '',\n  brand: row.brand || row.car_brand || '',\n  model: row.model || row.car_model || '',\n  year: row.year || row.car_year || '',\n  source_channel: row.source_channel || row.source || '',\n  store_id: row.store_id || row.shop_id || '',\n  created_at: row.created_at || '',\n  updated_at: row.updated_at || $json.received_at\n}}];"
      },
      "id": "code-customer-row",
