    {
      "parameters": {
        "jsCode": "const payload = $input.first().json || {};\nconst params = payload.content_params || {};\nconst expectedKey = $vars.PEIWAY_REALTIME_SYNC_KEY || '';\nconst suppliedKey = params.security_key || payload.security_key || '';\nconst record = params.record || payload.record || {};\nconst syncType = params.sync_type || payload.sync_type || '';\nconst uniqueKey = params.unique_key || record.id || payload.id || '';\nconst isValid = Boolean(expectedKey) && suppliedKey === expectedKey;\nreturn [{ json: {\n  ok: isValid,\n  sync_type: syncType,\n  unique_key: uniqueKey,\n  source_event_type: payload.event_type || '',\n  source_table: params.source_table || payload.source_table || '',\n  operation: params.operation || payload.operation || 'upsert',\n  received_at: new Date().toISOString(),\n  row: record,\n  error: isValid ? '' : 'invalid security key'\n}}];"
      },
      "id": "code-normalize-payload",
